---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button
  id="back-to-top"
  class="back-to-top"
  type="button"
  aria-label={t('ui.backToTop')}
  title={t('ui.backToTop')}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 19V5m0 0l-6 6m6-6l6 6"></path>
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 20;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--accent-contrast);
    background: var(--accent);
    border: none;
    border-radius: 50%;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.3);
    cursor: pointer;

    /* Oculto por defecto: aparece al bajar (ver script). visibility evita
       que quede enfocable con el teclado mientras no se ve. */
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s ease,
      filter 0.2s ease;
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .back-to-top:hover {
    filter: brightness(1.1);
  }

  svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<script>
  const button = document.getElementById('back-to-top');
  const SHOW_AFTER = 400; // píxeles de scroll antes de mostrar el botón

  const update = () => {
    button?.classList.toggle('visible', window.scrollY > SHOW_AFTER);
  };

  window.addEventListener('scroll', update, { passive: true });
  update();

  button?.addEventListener('click', () => {
    // El desplazamiento suave (o instantáneo si el usuario pidió menos
    // movimiento) lo define `scroll-behavior` en global.css.
    window.scrollTo({ top: 0 });
    // El botón se oculta al llegar arriba: soltamos el foco para no dejarlo "perdido".
    button.blur();
  });
</script>
