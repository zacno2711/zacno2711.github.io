---
import { useTranslations, type Lang } from '../i18n/ui';
import { web3formsAccessKey, isWeb3formsConfigured } from '../data/contact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// En producción, sin access key el envío fallaría: no mostramos el formulario.
// En desarrollo sí, para poder diseñarlo, con un aviso.
const showForm = isWeb3formsConfigured || import.meta.env.DEV;
---

{
  showForm && (
    <>
      {!isWeb3formsConfigured && (
        <p class="dev-notice">
          Solo visible en desarrollo: falta la access key de Web3Forms. Pégala en <code>src/data/contact.ts</code>.
          Sin ella, el formulario no se mostrará en el sitio publicado.
        </p>
      )}

      <!--
        action + method = respaldo si JavaScript falla (envío clásico).
        Con JavaScript, el script de abajo lo intercepta y envía con fetch,
        para mostrar el resultado sin salir del sitio.
      -->
      <h3 class="form-title">{t('contact.formTitle')}</h3>

      <form
        id="contact-form"
        class="form"
        method="POST"
        action="https://api.web3forms.com/submit"
        data-send={t('contact.form.send')}
        data-sending={t('contact.form.sending')}
        data-success={t('contact.form.success')}
        data-error={t('contact.form.error')}
      >
        <input type="hidden" name="access_key" value={web3formsAccessKey} />
        <input type="hidden" name="subject" value="Portfolio contact form" />

        {/* Trampa para bots: un humano no la ve, un bot suele marcarla */}
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display: none" />

        <div class="row">
          <label class="field">
            <span class="label">{t('contact.form.name')}</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label class="field">
            <span class="label">{t('contact.form.email')}</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
        </div>

        <label class="field">
          <span class="label">{t('contact.form.message')}</span>
          <textarea name="message" rows="6" required />
        </label>

        <button class="btn" type="submit">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
          </svg>
          <span>{t('contact.form.send')}</span>
        </button>

        <p class="status" data-status role="status" aria-live="polite" />
        <p class="note">{t('contact.form.note')}</p>
      </form>
    </>
  )
}

<style>
  .dev-notice {
    margin: 0 0 1rem;
    padding: 0.6rem 0.9rem;
    font-size: 0.85rem;
    color: var(--muted);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }

  .form-title {
    margin: 2.25rem 0 1rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .form {
    display: grid;
    gap: 1rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.35rem;
  }

  .label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    padding: 0.7rem 0.9rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: transparent;
  }

  textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .btn {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    font: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--accent-contrast);
    background: var(--accent);
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .btn:hover:not(:disabled) {
    filter: brightness(1.1);
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .btn svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .status {
    margin: 0;
    min-height: 1.4em;
    font-size: 0.9rem;
  }

  .status[data-state='success'] {
    color: var(--success);
  }

  .status[data-state='error'] {
    color: var(--danger);
  }

  .note {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const buttonLabel = button.querySelector<HTMLElement>('span')!;
    const { send, sending, success, error } = form.dataset;

    const show = (state: 'success' | 'error', text: string) => {
      status.dataset.state = state;
      status.textContent = text;
    };

    form.addEventListener('submit', async (event) => {
      // El navegador ya validó los campos "required" antes de llegar aquí
      event.preventDefault();

      const data = Object.fromEntries(new FormData(form));

      // Trampa para bots: si marcaron la casilla oculta, fingimos éxito y no enviamos nada
      if (data.botcheck) {
        show('success', success!);
        form.reset();
        return;
      }

      button.disabled = true;
      buttonLabel.textContent = sending!;
      status.textContent = '';
      delete status.dataset.state;

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await response.json().catch(() => ({}));

        if (response.ok && json.success) {
          show('success', success!);
          form.reset();
        } else {
          throw new Error(json?.body?.message ?? json?.message ?? `HTTP ${response.status}`);
        }
      } catch (err) {
        console.error('[contact form]', err);
        show('error', error!);
      } finally {
        button.disabled = false;
        buttonLabel.textContent = send!;
      }
    });
  }
</script>
