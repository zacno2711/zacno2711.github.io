---
import { cvFiles } from '../data/cv';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  // full: botón grande + enlace al otro idioma (sección Resume)
  // compact: solo el botón, más pequeño (sidebar)
  variant?: 'full' | 'compact';
}

const { lang, variant = 'full' } = Astro.props;
const t = useTranslations(lang);

const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const current = cvFiles[lang];
const other = cvFiles[otherLang];
---

<div class:list={['cv', variant]}>
  <!-- download = el navegador descarga el archivo en vez de abrirlo -->
  <a class="btn" href={current.href} download={current.filename}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 19h16"></path>
    </svg>
    <span>{variant === 'compact' ? t('cv.downloadShort') : t('cv.download')}</span>
  </a>

  {
    variant === 'full' && (
      <a class="other" href={other.href} download={other.filename} hreflang={otherLang}>
        {t('cv.other')}
      </a>
    )
  }
</div>

<style>
  .cv {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--accent-contrast);
    background: var(--accent);
    border-radius: var(--radius);
    text-decoration: none;
    transition: filter 0.2s ease;
  }

  .btn:hover {
    filter: brightness(1.1);
    text-decoration: none;
  }

  .btn svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .compact {
    width: 100%;
  }

  .compact .btn {
    width: 100%;
    padding: 0.55rem 1rem;
    font-size: 0.9rem;
  }

  .other {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .other:hover {
    color: var(--text);
  }
</style>
